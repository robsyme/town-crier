/*
 * Configuration for testing the Town Crier plugin.
 *
 * This config demonstrates how to:
 * 1. Load the local plugin
 * 2. Configure the API endpoint
 * 3. Filter which processes trigger notifications
 *
 * Run the test pipeline with:
 *   nextflow run main-with-plugin.nf -c nextflow-plugin.config
 */

plugins {
    // Load the local plugin from the town-crier directory
    id 'town-crier@0.1.0'
}

// Town Crier plugin configuration
towncrier {
    // Enable the plugin (default: true if endpoint is set)
    enabled = true

    // API endpoint to send notifications to
    // Run `python server.py` to start the test server
    endpoint = 'http://localhost:8080'

    // Filter which processes trigger notifications
    // Uses the same selector syntax as Nextflow's withName:
    // Examples:
    //   'ALIGNMENT'           - exact match
    //   '.*'                  - all processes (default)
    //   ['ALIGNMENT', 'MODKIT'] - multiple specific processes
    //   '!REPORT'             - all except REPORT
    //   '.*BAM.*'             - regex matching
    processes = ['ALIGNMENT', 'MODKIT']  // Only notify for ALIGNMENT and MODKIT
}

// Enable trace output to see plugin activity
trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
}
